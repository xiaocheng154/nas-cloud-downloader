#!/bin/bash

DOWNLOAD_DIR="${wizard_download_dir:-}"
CONFIG_DIR="${TRIM_PKGVAR}/config"
DOWNLOAD_FILE="${TRIM_PKGVAR}/download_dir"

DOWNLOAD_DIR="${DOWNLOAD_DIR:-${TRIM_PKGVAR}/downloads}"

case "$DOWNLOAD_DIR" in
/*) ;;
*) DOWNLOAD_DIR="${TRIM_PKGVAR}/downloads" ;;
esac

if ! mkdir -p "$CONFIG_DIR" "$DOWNLOAD_DIR"; then
    printf '%s\n' "无法创建下载目录：$DOWNLOAD_DIR" > "${TRIM_TEMP_LOGFILE:-/tmp/clouddl-install.log}"
    exit 1
fi
chmod 700 "$CONFIG_DIR"
chmod 755 \
    "$TRIM_APPDEST/runtime/python/bin/python" \
    "$TRIM_APPDEST/runtime/python/bin/python3" \
    "$TRIM_APPDEST/runtime/python/bin/python3.11" \
    "$TRIM_APPDEST/runtime/aria2/aria2c"
printf '%s\n' "$DOWNLOAD_DIR" > "$DOWNLOAD_FILE"
chmod 600 "$DOWNLOAD_FILE"
exit 0
